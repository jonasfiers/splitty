# Copy to scripts/deploy.env (not committed) and fill in. Read by deploy.sh,
# deploy-qa.sh and test-api.sh. Kept out of the public repo so it does not map
# the network.

# ssh target of the Proxmox host; every container is reached through it (pct).
PVE_SSH=root@192.0.2.10
# The API container (CT104) as CT101's nginx reaches it, for the health gate.
API_HOST=192.0.2.20
# Tailscale-only names, checked from CT115.
NEO4J_URL=https://neo4j.example.internal
QA_URL=https://splitty-qa.example.internal
